# Supabase Transaction pooler (port 6543) — used by the app on Vercel
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Supabase Session pooler or direct (port 5432) — used by Prisma CLI
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@HOST:5432/postgres"

# Optional: webhook URL that receives contact-form JSON after the Lead is saved
# CONTACT_FORM_ENDPOINT="https://example.com/hooks/facilities-man-leads"
