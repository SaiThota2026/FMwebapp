// prisma/schema.prisma (FACILITIES MAN)

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ────────────────────────────────────────────────────────────
// CORE MODELS
// ────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  role          Role      @default(USER)
  phone         String?   // optional contact number
  businessName  String?   // if they’re a business
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobs      Job[]         @relation("UserJobs")
  createdLeads Lead[]     @relation("CreatedByUser")
}

enum Role {
  USER   // individual or business customer
  ADMIN  // can manage users, jobs, content, locations
}

// ────────────────────────────────────────────────────────────
// JOBS / BOOKINGS
// ────────────────────────────────────────────────────────────

model Job {
  id            String      @id @default(cuid())
  title         String
  description   String?
  service       Service     @relation(fields: [serviceId], references: [id])
  serviceId     String
  user          User        @relation("UserJobs", fields: [userId], references: [id])
  userId        String
  location      Location    @relation(fields: [locationId], references: [id])
  locationId    String
  lead          Lead        @relation(fields: [leadId], references: [id])
  leadId        String
  status        JobStatus   @default(PENDING)
  createdAt     DateTime    @default(now())
  visitedAt     DateTime?   // when job was completed / visited
  scheduledAt   DateTime?   // agreed cleaning time
  notes         String?     // internal notes

  @@index([userId])
  @@index([status])
  @@index([locationId])
}

enum JobStatus {
  PENDING      // request submitted, not yet confirmed
  CONFIRMED    // admin confirmed; date scheduled
  ONGOING      // in progress
  COMPLETED    // done
  CANCELLED    // cancelled by user or admin
}

// ────────────────────────────────────────────────────────────
// SERVICES (WHAT WE DO)
// ────────────────────────────────────────────────────────────

model Service {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  description String?

  jobs     Job[]   @relation("ServiceJobs")
  contents Content[] @relation("ContentServices")

  @@index([slug])
}

// ────────────────────────────────────────────────────────────
// LEADS (CONTACT / BOOKING)
// ────────────────────────────────────────────────────────────

model Lead {
  id          String   @id @default(cuid())
  firstName   String?
  lastName    String?
  email       String   @db.VarChar(254)
  phone       String?
  company     String?  // if they’re a business
  service     Service  @relation(fields: [serviceId], references: [id])
  serviceId   String
  location    Location @relation(fields: [locationId], references: [id])
  locationId  String
  message     String?  // e.g., special instructions
  source      LeadSource? @default(WEBSITE_CONTACT)
  convertedAt DateTime? // when turned into a confirmed job
  status      LeadStatus @default(INBOX)
  createdAt   DateTime @default(now())
  createdBy   User?    @relation("CreatedByUser", fields: [createdById], references: [id])
  createdById String?

  @@index([email])
  @@index([status])
  @@index([locationId])
}

enum LeadSource {
  WEBSITE_CONTACT
  BOOKING_FORM
  PHONE_CALL
  REFERRAL
  SEARCH_ENGINE
}

enum LeadStatus {
  INBOX      // new, not yet handled
  REVIEW     // being reviewed
  QUOTED     // quote sent
  CONVERTED  // became a job
  LOST       // not interested
}

// ────────────────────────────────────────────────────────────
// LOCATIONS (LOCAL SEO STRENGTH)
// ────────────────────────────────────────────────────────────

model Location {
  id       String @id @default(cuid())
  name     String // e.g., "Newcastle, NSW"
  slug     String @unique // e.g., "newcastle", "wollongong", "canberra"
  city     String?
  state    String? // "NSW", "ACT"
  country  String @default("Australia")
  timezone String?

  jobs   Job[]     @relation("LocationJobs")
  leads  Lead[]    @relation("LocationLeads")

  @@index([slug])
  @@index([city, state])
}

// ────────────────────────────────────────────────────────────
// SEO / BLOG / CONTENT
// ────────────────────────────────────────────────────────────

model Content {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String   @db.VarChar(200)
  seoTitle    String?  @db.VarChar(200)
  seoDescription String? @db.VarChar(300)
  markdown    String?
  html        String?  // rich text rendered from markdown
  status      Status   @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?
  author      User?    @relation(fields: [authorId], references: [id])
  authorId    String?
  location    Location? @relation(fields: [locationId], references: [id])
  locationId  String?
  service     Service?  @relation("ContentServices", fields: [serviceId], references: [id])
  serviceId   String?

  @@index([status])
  @@index([locationId])
  @@index([serviceId])
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}